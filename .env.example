# warvex — Environment Configuration
# Copy this file to .env and fill in your values.
# Docker mode reads only DASHBOARD_PORT, DEMO_MODE, and AP_SUBNET.
# The Pi installer writes its own config to /etc/EdgeGateway/config.env.

# ── Network Interfaces ────────────────────────────────────
WAN_IFACE=eth0
AP_IFACE=wlan0

# ── WiFi Access Point ──────────────────────────────────────
AP_SSID=PiGateway
AP_PASS=<set-value>
AP_CHANNEL=6
AP_COUNTRY=US

# ── AP Network ─────────────────────────────────────────────
AP_IP=192.168.50.1
AP_SUBNET=192.168.50.0/24
AP_DHCP_START=192.168.50.10
AP_DHCP_END=192.168.50.100

# ── Cloudflare WARP ────────────────────────────────────────
WARP_MTU=1280

# ── Dashboard ──────────────────────────────────────────────
# Host port published on 127.0.0.1; the container always listens on 8080.
DASHBOARD_PORT=8080
# true = seeded fake stats and clients for previews/screenshots.
DEMO_MODE=false

# ── Telegram Bot (optional) ─────────────────────────────────
BOT_TOKEN=<set-value>
ADMIN_CHAT_ID=
